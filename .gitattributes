# Normalize line endings

* text=auto

# Always use LF for source code

*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.sh text eol=lf

# Configuration files

*.env text eol=lf
*.txt text eol=lf

# Windows scripts

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.exe binary
*.dll binary
*.so binary
*.whl binary
