[project]
name = "agenticos"
version = "0.0.535"
description = "OS for your agents."
requires-python = ">=3.12"
license = { text = "Apache-2.0" }
authors = [
    { name = "DEENUU1", email = "kacper.wlodarczyk@vstorm.co" },
]

dependencies = [

    "fastapi>=0.141.1",
    "uvicorn[standard]>=0.54.0",
    "pydantic[email]>=2.13.5",
    "pydantic-settings>=2.15.0",
    "python-multipart>=0.0.20",
    "logfire[fastapi,asyncpg,redis,httpx]>=5.1.0",
    "sqlalchemy[asyncio]>=2.1.3",
    "asyncpg>=0.31.0",

    "psycopg2-binary>=2.9.13",
    "alembic>=1.19.2",
    "greenlet>=3.5.5",
    "pyjwt>=2.15.1",
    "bcrypt>=4.0.0",
    "authlib>=1.8.0",

    "anyio>=4.15.1",
    "redis>=8.1.0",
    "aiosmtplib>=5.1.3",

    "itsdangerous>=2.2.0",
    "prefect>=3.8.7",

    "pydantic-ai-slim[openrouter,anthropic,google,duckduckgo,web-fetch,groq,mistral,cohere,huggingface,xai]>=2.52.0",
    "genai-prices>=0.1.4",
    "pydantic-ai-slim[mcp]>=2.52.0",

    "mcp>=2.3.0",

    "pydantic-ai-harness>=0.52.0",
    "websockets>=15.0",

    "rank-bm25>=0.2.2",
    "pymupdf>=1.28.2",

    "pillow>=10.0.0",
    "python-docx>=1.1.0",
    "openpyxl>=3.1.0",
    "llama-cloud>=2.16.0",
    "liteparse>=2.15.1",
    "google-api-python-client>=2.201.0",
    "google-auth>=2.59.1",
    "boto3>=1.43.108",

    "httpx>=0.28.0",
    "httpx2>=2.13.1",
    "click>=8.5.0",

    "tabulate>=0.9.0",

    "markdown-it-py>=4.0.0",
    "tqdm>=4.70.1",
    "tavily-python>=0.8.4",
    "pydantic-monty>=1.1.0",

    "pydantic-ai-skills>=2.0.0",

    "pydantic-ai-backend[console,remote,workspaces,daytona]>=0.2.32",

    "subagents-pydantic-ai>=0.2.25",
    "cryptography>=50.0.2",
    "aiogram>=3.31.0,<4.0",
    "slack-sdk>=3.45.0",

    "aiohttp>=3.14.4",

    "croniter>=3.0.0",
    "mem0ai>=2.2.1",
    "requests>=2.34.2",
    "xlrd>=2.0.2",
    "odfpy>=1.4.1",
    "python-pptx>=1.0.2",
    "olefile>=0.47",

    "ldap3>=2.9.1",

    "phonenumberslite>=9.0.40",
]

[project.optional-dependencies]

browser = [
    "cdp-use==1.4.5",
    "pydantic-ai-slim[typesafe]>=2.52.0",
]

kerberos = [
    "gssapi>=1.9.0",
]

[dependency-groups]
dev = [
    "pytest>=9.0.0",
    "anyio[trio]>=4.15.1",
    "pytest-cov>=6.1.0",
    "httpx>=0.28.0",
    "ruff>=0.16.10",
    "ty>=0.0.84",
    "pre-commit>=4.6.2",
    "pytest-xdist>=3.8.0",

    "pytest-randomly>=5.0.0",
    "vulture>=2.14",

    "deptry>=0.23.0",

    "types-ldap3>=2.9.13",
]

docs = [
    "mkdocs>=1.6.0",
    "mkdocs-glightbox>=0.5.2",
    "mkdocs-material>=9.5.0",
    "mkdocstrings[python]>=1.0.6",

    "mkdocs-static-i18n>=1.2.3",
]

[project.scripts]
agenticos = "cli.commands:main"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["app", "cli"]

[tool.vulture]
paths = ["app"]
min_confidence = 80
ignore_decorators = [
    "@field_validator",
    "@model_validator",
    "@field_serializer",
    "@model_serializer",
    "@computed_field",
    "@router.*",
    "@*.get",
    "@*.post",
    "@*.put",
    "@*.patch",
    "@*.delete",
    "@*.websocket",
]
ignore_names = []

[tool.deptry]
known_first_party = ["app", "cli"]
ignore = ["DEP001", "DEP003"]

[tool.deptry.per_rule_ignores]

DEP002 = [
    "python-multipart",
    "asyncpg",
    "psycopg2-binary",
    "greenlet",
    "itsdangerous",
    "aiohttp",

    "requests",
]

[tool.ruff]
target-version = "py312"
line-length = 100

[tool.ruff.lint]

select = [
    "E",
    "W",
    "F",
    "I",
    "B",
    "C4",
    "UP",
    "SIM",
    "RUF",
    "ASYNC",
    "S",
    "A",
    "DTZ",
    "T20",
    "LOG",
    "G",
    "PIE",
    "RET",
    "TID",
    "PTH",
    "ERA",
    "TRY",
]
ignore = [
    "E501",
    "E402",
    "B008",
    "B905",
    "RUF012",
    "RUF059",
    "TRY003",
    "TRY400",
    "S101",

    "S105",
    "S106",

    "ASYNC109",
    "ASYNC240",
]

[tool.ruff.lint.per-file-ignores]

"alembic/**" = ["ERA001", "S608"]

"../scripts/**" = ["T201", "S603", "S607"]

"../loadtest/**" = ["T201"]

"app/services/rag/vectorstore.py" = ["S608"]

"app/repositories/memory.py" = ["S608"]

"app/api/exception_handlers.py" = ["LOG004"]

"app/agents/capabilities/_registry.py" = ["A002"]

"tests/**" = [
    "S105",
    "S106",

    "S107",
    "S311",

    "S603",

    "S104",
    "A002",
    "TRY300",
    "RET504",
    "PLR2004",
    "SLF001",
]

"app/services/rag/retrieval.py" = ["S324"]
"app/services/file_upload.py" = ["TRY300", "PTH123", "PTH108"]

"app/core/sanitize.py" = ["PTH119", "S107"]
"app/services/agent.py" = ["TRY300", "TRY301"]
"app/services/channels/telegram.py" = ["TRY300", "S107"]
"app/services/rag/ingestion.py" = ["TRY300", "PTH123"]
"app/services/rag/documents.py" = ["PTH123"]
"app/services/rag/sources/google_drive.py" = ["ASYNC230", "PTH123"]
"app/worker/tasks/rag_tasks.py" = ["TRY300"]
"app/clients/redis.py" = ["TRY300"]
"app/core/security.py" = ["TRY300"]
"app/commands/seed.py" = ["S311"]

"app/services/channels/slack.py" = ["ASYNC110"]
"app/services/rag/connectors/google_drive.py" = ["PTH123"]

"cli/**" = ["S104", "TRY300"]

[tool.ruff.lint.isort]
known-first-party = ["app", "cli"]

[tool.ty.terminal]

error-on-warning = true

[tool.ty.environment]
python-version = "3.12"

[tool.ty.src]

exclude = [
    "alembic/",
    "tests/",
    "cli/",
]

[tool.ty.rules]

invalid-parameter-default = "warn"

invalid-argument-type = "warn"

invalid-assignment = "warn"

unresolved-attribute = "warn"

deprecated = "warn"

unresolved-import = "ignore"

no-matching-overload = "warn"

unused-type-ignore-comment = "warn"

unused-ignore-comment = "ignore"

unsupported-operator = "warn"

invalid-await = "warn"

invalid-context-manager = "warn"

missing-argument = "warn"

